rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.plan == 'free'
        && request.resource.data.email == request.auth.token.email;
      allow update: if admin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.plan == resource.data.plan
        && request.resource.data.email == resource.data.email);
      allow delete: if admin();
    }

    match /ads/{adId} {
      allow read: if resource.data.status == 'approved'
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || admin();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 90
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 800
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.whatsapp is string;
      allow update: if admin() || (signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title','price','category','whatsapp','imageUrl','description','status','updatedAt','createdAt']));
      allow delete: if admin() || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /planRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && ((request.resource.data.plan == 'monthly' && request.resource.data.price == 19.90)
          || (request.resource.data.plan == 'premium' && request.resource.data.price == 39.90));
      allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if admin();
    }
  }
}